# ==============================================================
# PICRYPT BACKEND ENVIRONMENT CONFIGURATION (SAMPLE TEMPLATE)
# Copy this file to .env and fill in your actual production/local secrets.
# DO NOT commit .env with real credentials to GitHub.
# ==============================================================

# Django Secret Key (Generate a secure 50+ character random string in production)
DJANGO_SECRET_KEY=change-me-to-a-very-long-and-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,your-backend-domain.com

# Database Configuration (Option A: DATABASE_URL for Render / Railway / Neon / Supabase; Option B: Individual credentials)
# Commented by agent, reason: Document DATABASE_URL option for cloud databases
# # Database Configuration (MySQL / PostgreSQL)
# End commented by agent
# DATABASE_URL=postgresql://user:password@host:port/dbname
DB_ENGINE=django.db.backends.mysql
DB_NAME=picrypt_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# Email SMTP Credentials (Gmail App Password or SendGrid / Mailgun)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# CORS Allowed Frontend Origins (Comma-separated URLs)
FRONTEND_URL=http://localhost:5173,https://your-frontend-domain.vercel.app
